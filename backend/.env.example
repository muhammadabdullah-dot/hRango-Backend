APP_NAME=HRango API
PORT=8000
# SQL Server ODBC connection string. Windows login on a local server:
# DB_URL=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=hrango_dev;Trusted_Connection=yes;TrustServerCertificate=yes
# SQL login: replace Trusted_Connection=yes with Uid=...;Pwd=...
DB_URL=
JWT_SECRET=change-me
CORS_ORIGINS=*
LOG_DIR=
# Uploaded files (blank = the uploads folder in backend), size limit, how long download links work
UPLOAD_DIR=
MAX_UPLOAD_MB=25
FILE_LINK_MINUTES=30
# This API's address as browsers reach it, when the frontend is served from another address.
PUBLIC_BASE_URL=
# Deliver webhooks from the API process (false when scripts/webhooks.py runs as a service)
WEBHOOK_WORKER=true
WEBHOOK_POLL_SECONDS=5
# Writing with AI: blank = off (AI routes answer 503 AI_UNAVAILABLE).
AI_PROVIDER=
# Outgoing mail: off until SMTP is set up (mail statuses read "disabled").
MAIL_ENABLED=false
