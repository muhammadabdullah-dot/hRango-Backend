APP_NAME=HRango API
# production (default) or development. Development allows CORS_ORIGINS=* and serves /docs.
APP_ENV=development
PORT=8000
# SQL Server ODBC connection string. Windows login on a local server:
# DB_URL=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=hrango_dev;Trusted_Connection=yes;TrustServerCertificate=yes
# SQL login: replace Trusted_Connection=yes with Uid=...;Pwd=...
DB_URL=
# Two different random secrets of at least 32 characters; the API will not start without them. Make each with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET signs sign-ins (changing it signs everyone out); FILE_LINK_SECRET signs download links.
JWT_SECRET=
FILE_LINK_SECRET=
# Frontend origin(s), comma-separated, e.g. https://app.example.com. Blank when the frontend proxies /api.
# "*" (any origin) is accepted only with APP_ENV=development.
CORS_ORIGINS=*
# Interactive API docs (/docs, /redoc, /openapi.json). Blank = on in development, off in production.
API_DOCS=
LOG_DIR=
# Uploaded files (blank = the uploads folder in backend), size limit, how long download links work
UPLOAD_DIR=
MAX_UPLOAD_MB=25
FILE_LINK_MINUTES=30
# This API's address as browsers reach it, when the frontend is served from another address.
PUBLIC_BASE_URL=
# Deliver webhooks from the API process (false when scripts/webhooks.py runs as a service)
WEBHOOK_WORKER=true
WEBHOOK_POLL_SECONDS=5
# Let webhooks call private / loopback addresses (a receiver on your own machine). Development only.
WEBHOOK_ALLOW_PRIVATE=false
# Pause sign-in after repeated failures (5 per email and address, 20 per email, 50 per address, in 15 minutes).
LOGIN_THROTTLE=true
# Proxies (nginx, IIS) whose X-Forwarded-For is believed, comma-separated; "*" = any. Keep 127.0.0.1 when the
# proxy runs on this machine, so sign-in limits and the sessions list see each caller's real address.
FORWARDED_ALLOW_IPS=127.0.0.1
# Writing with AI: blank = off (AI routes answer 503 AI_UNAVAILABLE).
AI_PROVIDER=
# Outgoing mail: off until SMTP is set up (mail statuses read "disabled").
MAIL_ENABLED=false
